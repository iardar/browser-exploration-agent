# Set credentials through the local environment or an untracked .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PLAYWRIGHT_MCP_URL=http://127.0.0.1:8931/mcp
BROWSER_MODEL_API=auto
# BROWSER_REASONING_EFFORT=medium
BROWSER_OUTPUT_DIR=runs
BROWSER_MAX_STEPS=30
BROWSER_MAX_MODEL_ITERATIONS=20
BROWSER_MAX_DURATION_SECONDS=120
BROWSER_TOOL_TIMEOUT_SECONDS=20
BROWSER_MAX_RECENT_OBSERVATIONS=5
BROWSER_MAX_OBSERVATION_CHARS=6000
BROWSER_MAX_CONTEXT_CHARS=18000
BROWSER_RETAIN_RAW_EVIDENCE=false

# This attests to independently installed browser egress controls; it is not a firewall.
BROWSER_NETWORK_RESTRICTED=false
BROWSER_ALLOW_PRIVATE_NETWORK=false

BROWSER_LANGSMITH_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=browser-exploration
