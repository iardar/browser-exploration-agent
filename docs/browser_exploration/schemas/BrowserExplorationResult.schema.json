{
  "$defs": {
    "BrowserFinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "expected_behavior": {
          "title": "Expected Behavior",
          "type": "string"
        },
        "observed_behavior": {
          "title": "Observed Behavior",
          "type": "string"
        },
        "reproduction_steps": {
          "items": {
            "type": "string"
          },
          "title": "Reproduction Steps",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "verification_status": {
          "enum": [
            "confirmed",
            "potential",
            "inconclusive"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "informational"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "expected_behavior",
        "observed_behavior",
        "verification_status"
      ],
      "title": "BrowserFinding",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "retained": {
          "default": false,
          "title": "Retained",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "observation_id",
        "kind"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ExecutionMetrics": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "browser_tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Browser Tool Calls",
          "type": "integer"
        },
        "successful_browser_tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Successful Browser Tool Calls",
          "type": "integer"
        },
        "failed_browser_tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Failed Browser Tool Calls",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        },
        "findings_count": {
          "default": 0,
          "minimum": 0,
          "title": "Findings Count",
          "type": "integer"
        },
        "verified_behaviors_count": {
          "default": 0,
          "minimum": 0,
          "title": "Verified Behaviors Count",
          "type": "integer"
        }
      },
      "title": "ExecutionMetrics",
      "type": "object"
    },
    "RunError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RunError",
      "type": "object"
    },
    "VerifiedBehavior": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "description",
        "evidence_ids"
      ],
      "title": "VerifiedBehavior",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "target_url": {
      "title": "Target Url",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "step_limit",
        "model_limit",
        "timeout",
        "cancelled",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "verified_behaviors": {
      "items": {
        "$ref": "#/$defs/VerifiedBehavior"
      },
      "title": "Verified Behaviors",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/BrowserFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "unresolved_questions": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/ExecutionMetrics"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/RunError"
      },
      "title": "Errors",
      "type": "array"
    },
    "observed_actions": {
      "items": {
        "type": "string"
      },
      "title": "Observed Actions",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "objective",
    "target_url",
    "status",
    "started_at",
    "finished_at"
  ],
  "title": "BrowserExplorationResult",
  "type": "object"
}
